{
  "name": "planar-codex",
  "version": "0.3.0",
  "private": true,
  "description": "Development tooling for the Planar Codex Foundry VTT module. Foundry loads the module directly; nothing here ships except the vendored files in lib/.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint scripts tools test",
    "test": "npm run lint && node --test \"test/*.test.mjs\"",
    "build:lib": "node tools/build-lib.mjs",
    "stamp": "node tools/stamp-manifest.mjs",
    "package": "node tools/package.mjs",
    "check:vault": "node tools/vault-check.mjs",
    "harness": "node tools/serve.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "linkedom": "^0.18.13",
    "marked": "^18.0.14"
  }
}
